# Database PostgreSQL
POSTGRES_DB=chatbot_shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourStrongPasswordHere123

# Zalo Official Account Integration
ZALO_APP_ID=
ZALO_APP_SECRET=
